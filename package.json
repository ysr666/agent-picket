{
  "name": "agent-picket",
  "version": "0.0.0",
  "private": true,
  "description": "Host-neutral AI agent union core (experimental)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm test && npm run build",
    "test:dsh:real": "node --experimental-strip-types --test tests/dsh*.real.test.ts",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./dsh": {
      "types": "./dist/adapters/dsh/plugin.d.ts",
      "default": "./dist/adapters/dsh/plugin.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "docs/"
  ]
}
