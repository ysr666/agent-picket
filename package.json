{
  "name": "agent-picket",
  "version": "0.0.0",
  "private": true,
  "description": "Host-neutral AI agent union core (experimental)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm run build && npm test",
    "test:dsh:real": "node scripts/run-real-tests.mjs",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && node scripts/build-dsh-client.mjs"
  },
  "main": "./dist/adapters/dsh/plugin.js",
  "types": "./dist/adapters/dsh/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/adapters/dsh/plugin.d.ts",
      "default": "./dist/adapters/dsh/plugin.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./dsh": {
      "types": "./dist/adapters/dsh/plugin.d.ts",
      "default": "./dist/adapters/dsh/plugin.js"
    },
    "./client": {
      "types": "./dist/adapters/dsh/client.d.ts",
      "default": "./dist/adapters/dsh/client.js"
    }
  },
  "files": [
    "dist/",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map",
    "README.md",
    "LICENSE",
    "cordis.patch.yml",
    "docs/",
    "!docs/AGENT_PICKET_V2_IMPLEMENTATION_AND_SAFETY_20261011.zh.md",
    "!docs/DSH_02_LIFETIME_AUTH_BRIDGE_RESEARCH.zh.md",
    "!docs/DSH_LIFETIME_WORK_RPC_V1.zh.md",
    "!docs/UNION_LIFETIME_WEB_INTEGRATION.zh.md",
    "!docs/CANONICAL_MERGE_PLAN.md",
    "!docs/MAIN_23_MERGE_RECONCILIATION.md",
    "!docs/PARALLEL_BRANCH_PARITY_2026_10_10.md",
    "!docs/PR_STACK_RELEASE_AUDIT_2026_10_10.md",
    "!docs/RELEASE_READINESS_2026_10_10.md",
    "!docs/DSH_017_HOST_PROFILE_EXPERIMENT.md",
    "!docs/DSH_02_MENU_REFRESH_READY_REVIEW.md",
    "!docs/PR_87_88_89_MERGE_GATE_20261011.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-commands"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
