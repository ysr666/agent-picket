{
  "name": "agent-picket",
  "version": "0.0.0",
  "private": true,
  "description": "Host-neutral AI agent union core (experimental)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:dsh-host-archives": "bash scripts/verify-dsh-host-archives.sh",
    "check:dsh-multiowner": "bash scripts/verify-dsh-multiowner.sh",
    "research:dsh-disk-cas": "bash scripts/verify-dsh-cas-research.sh",
    "research:dsh-modern-storage": "bash scripts/verify-dsh-modern-storage.sh",
    "check:dsh-modern-migration": "bash scripts/verify-dsh-modern-migration.sh",
    "check:dsh-modern-host-multiowner": "bash scripts/verify-dsh-modern-host-multiowner.sh",
    "check:dsh-current": "bash scripts/verify-dsh-current-compat.sh",
    "check": "npm run typecheck && npm run build && npm test",
    "test:dsh:real": "node scripts/run-real-tests.mjs",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && node scripts/build-dsh-client.mjs",
    "release:gate": "node scripts/check-first-release.mjs"
  },
  "main": "./dist/adapters/dsh/plugin.js",
  "types": "./dist/adapters/dsh/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/adapters/dsh/plugin.d.ts",
      "default": "./dist/adapters/dsh/plugin.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./dsh": {
      "types": "./dist/adapters/dsh/plugin.d.ts",
      "default": "./dist/adapters/dsh/plugin.js"
    },
    "./client": {
      "types": "./dist/adapters/dsh/client.d.ts",
      "default": "./dist/adapters/dsh/client.js"
    }
  },
