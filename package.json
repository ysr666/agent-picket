{
  "name": "agent-picket",
  "version": "0.0.0",
  "private": true,
  "description": "Host-neutral AI agent union core (experimental)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm run build && npm test",
    "test:dsh:real": "node scripts/run-real-tests.mjs",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && node scripts/build-dsh-client.mjs"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./dsh": {
      "types": "./dist/adapters/dsh/plugin.d.ts",
      "default": "./dist/adapters/dsh/plugin.js"
    },
    "./client": {
      "types": "./dist/adapters/dsh/client.d.ts",
      "default": "./dist/adapters/dsh/client.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "cordis.patch.yml",
    "docs/"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-commands"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
